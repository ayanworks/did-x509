{
  "tasks": {
    "start": "deno run --allow-read --allow-env --allow-net src/main.ts",
    "all": "deno run --allow-read --allow-env --allow-net src/cli.ts",
    "check": "deno check src/main.ts src/cli.ts src/server.ts src/flows.ts"
  },
  "deploy": {
    "runtime": {
      "type": "dynamic",
      "entrypoint": "./src/main.ts"
    }
  },
  "imports": {
    "@didx509/core": "../typescript/dist/index.js",
    "@peculiar/x509": "npm:@peculiar/x509@2.0.0",
    "pkijs": "npm:pkijs@3.4.0",
    "asn1js": "npm:asn1js@3.0.6",
    "reflect-metadata": "npm:reflect-metadata@0.2.2",
    "did-resolver": "npm:did-resolver@4.1.0",
    "@digitalbazaar/data-integrity": "npm:@digitalbazaar/data-integrity@2.5.0",
    "@digitalbazaar/data-integrity-context": "npm:@digitalbazaar/data-integrity-context@2.0.0",
    "@digitalbazaar/ed25519-verification-key-2020": "npm:@digitalbazaar/ed25519-verification-key-2020@4.2.0",
    "@digitalbazaar/eddsa-rdfc-2022-cryptosuite": "npm:@digitalbazaar/eddsa-rdfc-2022-cryptosuite@1.3.0",
    "@digitalbazaar/credentials-context": "npm:@digitalbazaar/credentials-context@3.2.0",
    "@digitalbazaar/security-context": "npm:@digitalbazaar/security-context@1.0.0",
    "@digitalbazaar/vc": "npm:@digitalbazaar/vc@7.3.0",
    "jsonld-signatures": "npm:jsonld-signatures@11.6.0",
    "multiformats": "npm:multiformats@13.4.0",
    "@owf/mdoc": "npm:@owf/mdoc@0.8.3",
    "@owf/cose": "npm:@owf/cose@0.5.0",
    "@owf/crypto": "npm:@owf/crypto@0.5.0",
    "@sd-jwt/core": "npm:@sd-jwt/core@0.23.0",
    "@sd-jwt/sd-jwt-vc": "npm:@sd-jwt/sd-jwt-vc@0.23.0",
    "@noble/curves": "npm:@noble/curves@2.0.0",
    "@noble/hashes": "npm:@noble/hashes@2.0.0"
  },
  "compilerOptions": {
    "lib": [
      "deno.window",
      "dom",
      "dom.iterable",
      "esnext"
    ]
  },
  "nodeModulesDir": "auto"
}