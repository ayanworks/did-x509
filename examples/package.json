{
  "name": "did-x509-examples",
  "private": true,
  "description": "Runnable did:x509 examples: resolution + signing JSON-LD, SD-JWT and mDoc credentials",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "resolve": "node 01-resolve.ts",
    "sign:jsonld": "node 02-jsonld.ts",
    "sign:sd-jwt": "node 03-sd-jwt.ts",
    "sign:mdoc": "node 04-mdoc.ts",
    "credo": "node 05-credo-askar.ts",
    "all": "node 01-resolve.ts && node 02-jsonld.ts && node 03-sd-jwt.ts && node 04-mdoc.ts && node 05-credo-askar.ts"
  },
  "dependencies": {
    "@credo-ts/askar": "0.7.2",
    "@credo-ts/core": "0.7.2",
    "@credo-ts/node": "0.7.2",
    "@didx509/core": "file:../typescript",
    "@didx509/credo": "file:../typescript-credo",
    "@openwallet-foundation/askar-nodejs": "0.6.1",
    "@digitalbazaar/credentials-context": "^3.2.0",
    "@digitalbazaar/data-integrity": "^2.5.0",
    "@digitalbazaar/data-integrity-context": "^2.0.0",
    "@digitalbazaar/ed25519-verification-key-2020": "^4.2.0",
    "@digitalbazaar/eddsa-rdfc-2022-cryptosuite": "^1.3.0",
    "@digitalbazaar/security-context": "^1.0.0",
    "@digitalbazaar/vc": "^7.3.0",
    "@noble/curves": "^2.0.0",
    "@noble/hashes": "^2.0.0",
    "@owf/cose": "^0.5.0",
    "@owf/crypto": "^0.5.0",
    "@owf/mdoc": "^0.8.3",
    "@peculiar/x509": "^2.0.0",
    "@sd-jwt/core": "^0.23.0",
    "@sd-jwt/sd-jwt-vc": "^0.23.0",
    "did-resolver": "^4.1.0",
    "jsonld-signatures": "^11.6.0",
    "multiformats": "^13.4.0",
    "reflect-metadata": "^0.2.2"
  },
  "allowScripts": {
    "@openwallet-foundation/askar-nodejs@0.6.1": true,
    "cbor-extract": true,
    "koffi@2.16.3": true
  }
}
